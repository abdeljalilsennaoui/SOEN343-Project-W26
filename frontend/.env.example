# ─── Google Maps ─────────────────────────────────────────────────────────────
# Required for the /map page (Maps JavaScript API + Directions + Geocoding).
#
# Steps:
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create an API key (or ask the team lead to share theirs)
#   3. Enable these three APIs in the same project:
#        - Maps JavaScript API
#        - Directions API
#        - Geocoding API
#   4. Restrict the key:
#        HTTP referrers: http://localhost:*/*
#        API restrictions: only the 3 APIs above
# ─────────────────────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ─── Firebase ────────────────────────────────────────────────────────────────
# Required for authentication (login / register / Google sign-in).
#
# Steps:
#   1. Go to https://console.firebase.google.com → Project Settings → Your apps
#   2. Select the web app (or ask the team lead to share the config snippet)
#   3. Copy each value below from the firebaseConfig object
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
